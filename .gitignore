# AGENT-DONE(codex): ignore-native-build-artifacts
# 프로젝트 제외 경로
/.gradle/
/build/
/.kotlin/
/engine/audio/.gradle/
/engine/audio/build/
/engine/fmod/.gradle/
/engine/fmod/build/
/engine/browserhost/.gradle/
/engine/browserhost/build/
/engine/window/.gradle/
/engine/window/build/
/run/
/run-client2/

# Native module build output and caches (including new engine modules)
/engine/*/build/
/engine/*/.gradle/

# CMake generated build directories and metadata
cmake-build*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt

# Generated Windows native libraries (already tracked runtime DLLs stay tracked)
*.[dD][lL][lL]
